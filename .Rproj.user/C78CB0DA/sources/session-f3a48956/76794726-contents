# Meine erste Idee war eine analytische Lösung, aber die ist auch nicht so schnell,
# und die marginal densities stimmen glaube ich nicht. Der contour plot alleine sieht aber
# ordentlich aus

# analytic_bivariate_with_truncated_y_margins.R
# -------------------------------------------------------------------------
# Analytic bivariate normal joint density plot (Y on x-axis, X on y-axis)
# with marginal (right side) showing the unconditional X density and the two
# truncated-X densities (X > t and X <= t). No sampling.
# -------------------------------------------------------------------------

# Packages (install if missing)
pkgs <- c("ggplot2", "mvtnorm", "viridis", "patchwork")
for (p in pkgs) if (!requireNamespace(p, quietly = TRUE)) install.packages(p)

library(ggplot2)
library(mvtnorm)
library(viridis)
library(patchwork)

# ---------------- Parameters ----------------
muX    <- 0     # mean of true quality X
sigmaX <- 1     # sd of true quality X
muY    <- 0     # mean of predictor Y
sigmaY <- 1     # sd of predictor Y
rho    <- 0.6   # correlation between X and Y (predictor-truth)
t      <- 1.0   # truncation cutoff on the TRUE variable X (X > t selected)
# --------------------------------------------

# Derived: bivariate mean & cov (order is Y, X because x-axis = Y, y-axis = X)
mean_vec <- c(muY, muX)
cov_mat  <- matrix(c(sigmaY^2,          rho * sigmaY * sigmaX,
                     rho * sigmaY * sigmaX,  sigmaX^2),
                   nrow = 2, byrow = TRUE)

# predictor-axis position corresponding to X = t (E[Y | X = t])
x_cut_pred <- muY + rho * (sigmaY / sigmaX) * (t - muX)
y_cut_truth <- t

# grid for main joint density evaluation
nx <- 300
ny <- 300
xlim <- c(muY - 4 * sigmaY, muY + 4 * sigmaY)
ylim <- c(muX - 4 * sigmaX, muX + 4 * sigmaX)

xs <- seq(xlim[1], xlim[2], length.out = nx)
ys <- seq(ylim[1], ylim[2], length.out = ny)
grid <- expand.grid(x = xs, y = ys)

# analytic bivariate density on the grid
grid$density <- mvtnorm::dmvnorm(grid, mean = mean_vec, sigma = cov_mat)

# ---------------- analytic truncated-normal densities for X ----------------
# helper: one-sided truncated densities (analytical)
d_trunc_upper <- function(x, t, mu, sigma) {
    # density of X | X > t, returns 0 for x <= t
    alpha <- (t - mu)/sigma
    denom <- 1 - pnorm(alpha)
    dens <- ifelse(x > t, dnorm((x - mu)/sigma) / sigma / denom, 0)
    dens
}
d_trunc_lower <- function(x, t, mu, sigma) {
    # density of X | X <= t, returns 0 for x > t
    alpha <- (t - mu)/sigma
    denom <- pnorm(alpha)
    dens <- ifelse(x <= t, dnorm((x - mu)/sigma) / sigma / denom, 0)
    dens
}
d_uncond <- function(x, mu, sigma) dnorm((x - mu)/sigma) / sigma

# prepare y-grid for marginal plotting (use same ys as main plot so they align)
yvals <- ys
df_marg <- data.frame(
    y = rep(yvals, 3),
    density = c(d_uncond(yvals, muX, sigmaX),
                d_trunc_upper(yvals, t, muX, sigmaX),
                d_trunc_lower(yvals, t, muX, sigmaX)),
    group = rep(c("X (unconditional)", "X | X > t (selected)", "X | X <= t (unselected)"),
                each = length(yvals))
)

# scale densities so margin plot width is visually balanced:
# (optional) keep absolute densities but in many cases you'd like them scaled to same max
# Here we'll keep raw densities but later control the width by plot widths in patchwork.

# ---------------- create main joint density plot ----------------
main_plot <- ggplot(grid, aes(x = x, y = y, z = density)) +
    geom_raster(aes(fill = density), interpolate = TRUE) +
    geom_contour(aes(z = density), colour = "black", alpha = 0.6, bins = 8) +
    scale_fill_viridis(option = "viridis", name = "joint\ndensity") +
    geom_vline(xintercept = x_cut_pred, linetype = "dashed", size = 1, color = "white") +
    geom_hline(yintercept = y_cut_truth, linetype = "dashed", size = 1, color = "red") +
    geom_point(aes(x = muY, y = muX), colour = "white", shape = 21, fill = "black", size = 3) +
    labs(title = "Bivariate normal (predictor Y on x-axis, truth X on y-axis)",
         subtitle = sprintf("muX=%.2g, sigmaX=%.2g | muY=%.2g, sigmaY=%.2g | rho=%.2g | t=%.2g",
                            muX, sigmaX, muY, sigmaY, rho, t),
         x = "Predictor (Y)",
         y = "Truth (X)") +
    coord_cartesian(xlim = xlim, ylim = ylim, expand = FALSE) +
    theme_minimal(base_size = 12) +
    theme(legend.position = "right")

# ---------------- create right margin plot (horizontal density along y) ----------------
# We'll draw filled areas (geom_area) of density vs y, then flip coords so density runs to the right.
right_margin <- ggplot(df_marg, aes(x = rev(density), y = y, fill = group)) +
    geom_area(data = subset(df_marg, group == "X (unconditional)"),
              aes(x = rev(density), y = y), inherit.aes = FALSE, fill = "grey70", alpha = 0.6) +
    geom_area(data = subset(df_marg, group == "X | X <= t (unselected)"),
              aes(x = rev(density), y = y), inherit.aes = FALSE, fill = "tomato", alpha = 0.6) +
    geom_area(data = subset(df_marg, group == "X | X > t (selected)"),
              aes(x = rev(density), y = y), inherit.aes = FALSE, fill = "steelblue", alpha = 0.6) +
    # vertical line for the truncation on the truth axis (this is a horizontal line in the margin's coord)
    geom_hline(yintercept = y_cut_truth, colour = "red", linetype = "dashed") +
    coord_cartesian(ylim = ylim, expand = FALSE) +
    # flip so that densities extend to the right of the main plot
    # coord_flip() +
    theme_minimal(base_size = 11) +
    theme(
        axis.title = element_blank(),
        axis.text.x = element_blank(),
        axis.ticks = element_blank(),
        legend.position = "none",
        panel.grid = element_blank()
    )

# ---------------- combine main plot + right margin using patchwork ----------------
# give more width to main plot and less to margin
combined <- main_plot + right_margin + plot_layout(widths = c(4, 1), guides = "collect")

# print combined figure
print(combined)

# ---------------- analytic moments for reference (printed) ----------------
alpha <- (t - muX) / sigmaX
lambda <- dnorm(alpha) / (1 - pnorm(alpha))
E_X_trunc_upper <- muX + sigmaX * lambda
Var_X_trunc_upper <- sigmaX^2 * (1 - alpha * lambda - lambda^2)

lambda_lower <- -dnorm(alpha) / pnorm(alpha)   # for X <= t
E_X_trunc_lower <- muX + sigmaX * lambda_lower
Var_X_trunc_lower <- sigmaX^2 * (1 - alpha * lambda_lower - lambda_lower^2)

E_Y_given_Xpos <- muY + rho * (sigmaY / sigmaX) * (E_X_trunc_upper - muX)
Var_Y_given_Xpos <- (rho * sigmaY / sigmaX)^2 * Var_X_trunc_upper + sigmaY^2 * (1 - rho^2)

cat("\nAnalytic truncated-X summaries:\n")
cat(sprintf("  E[X | X > t] = %.5f, Var = %.5f\n", E_X_trunc_upper, Var_X_trunc_upper))
cat(sprintf("  E[X | X <= t] = %.5f, Var = %.5f\n", E_X_trunc_lower, Var_X_trunc_lower))
cat(sprintf("  E[Y | X > t] = %.5f, Var = %.5f\n", E_Y_given_Xpos, Var_Y_given_Xpos))
