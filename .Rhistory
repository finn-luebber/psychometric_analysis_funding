library(ggplot2)
library(ggpattern)
library(dplyr)
library(patchwork)
###### submission distribution
# Parameters
mean_val <- 50000
sd_val   <- 5000
threshold_actual   <- qnorm(0.75, mean = mean_val, sd = sd_val)  # 75th percentile
# Data
x_vals <- seq(mean_val - 4*sd_val, mean_val + 4*sd_val, length.out = 1000)
df <- data.frame(
x = x_vals,
y = dnorm(x_vals, mean = mean_val, sd = sd_val),
group = ifelse(x_vals < threshold_actual, "Bottom 75%", "Top 25%")
)
# Plot
actual_values_distribution <- ggplot(df, aes(x = x, y = y, color = group)) +
geom_area(alpha = 0.8, fill = "white", size = 1.2) +
geom_vline(xintercept = threshold_actual, linetype = "dashed") +
# scale_fill_manual(values = c("Bottom 75%" = "purple", "Top 25%" = "orange")) +
scale_color_manual(values = c("Bottom 75%" = "purple", "Top 25%" = "orange")) +
xlim(c(30000, 70000))+
guides(
color = "none"
)+
labs(
title = "",
x = "*Actual* Goodness in €",
y = "Density"
) +
theme_minimal(base_family = "Helvetica") +
theme(
legend.title = element_blank(),
legend.text = element_text(size = 20),
axis.title = element_text(size = 20, face = "bold", color = "black"),
axis.text.x = element_text(size = 16, color = "black"),
axis.text.y = element_blank(),
plot.title = element_blank(),
plot.caption = element_blank(),
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm"),
legend.position = "bottom", legend.box = "vertical"
)
###### SDT plot
# Theoretical parameters
mu_low  <- 50000
cor_pred_actual <- .4
sigma <- 5000
mu_high <- mu_low + cor_pred_actual * sqrt(2) * sigma  # separation for ~cor 0.4
# Decision threshold: top 25% of predicted values
top_x <- .25
threshold_predicted <- qnorm(1-top_x, mean = (mu_low + mu_high)/2, sd = sigma)  # approximate
# X-axis range
x <- seq(mu_low - 3*sigma, mu_high + 3*sigma, length.out = 1000)
# group names
top_group_label <- paste0("top ", top_x * 100, " percent")
bottom_group_label <- paste0("bottom ", (1-top_x) * 100, " percent")
# Compute densities
dens_df <- data.frame(
x = rep(x, 2),
y = c(dnorm(x, mu_high, sigma), dnorm(x, mu_low, sigma)),
actual_group = rep(c(top_group_label, bottom_group_label), each = length(x))
)
# Add shading info and outcome labels
dens_df <- dens_df %>%
mutate(
fill_side = ifelse(x >= threshold_predicted, "Accept", "Reject"),
outcome = case_when(
actual_group == top_group_label & fill_side == "Accept" ~ "Hit",
actual_group == top_group_label & fill_side == "Reject" ~ "Miss",
actual_group == bottom_group_label  & fill_side == "Accept" ~ "False Alarm",
actual_group == bottom_group_label  & fill_side == "Reject" ~ "Correct Rejection"
),
outcome = factor(outcome, levels = c("Hit", "Miss", "False Alarm", "Correct Rejection"))
)
# --- Plot ---
p <- ggplot() +
# Fill ribbons: draw High group first, Low group second (so Low is on top)
geom_ribbon(
data = filter(dens_df, actual_group == top_group_label),
aes(x = x, ymin = 0, ymax = y, fill = outcome),
color = NA
) +
geom_ribbon(
data = filter(dens_df, actual_group == bottom_group_label),
aes(x = x, ymin = 0, ymax = y, fill = outcome),
color = NA
) +
# Outlines for every region (no legend for this layer)
geom_ribbon(
data = dens_df,
aes(x = x, ymin = 0, ymax = y, group = interaction(outcome, actual_group), color = actual_group),
fill = NA, size = 0.6, show.legend = FALSE
) +
# Density lines (this provides the color legend for groups)
geom_line(data = dens_df, aes(x = x, y = y, color = actual_group), size = 1.1) +
# Threshold
geom_vline(xintercept = threshold_predicted, linetype = "dashed", size = 0.9) +
# Scales: fill = outcomes; color = group
xlim(c(30000, 70000))+
scale_fill_manual(
values = c(
"Hit" = scales::alpha("orange", 0.6),
"Miss" = "white",
"False Alarm" = scales::alpha("purple", 0.6),
"Correct Rejection" = "white"
)
) +
# scale_color_manual(values = c(top_group_label = "purple", bottom_group_label = "orange")) +
scale_color_manual(values = setNames(
c("orange", "purple"),
c(top_group_label, bottom_group_label)
)) +
# Make the fill legend keys show colored outlines for the white entries:
guides(
fill = guide_legend(
override.aes = list(
colour = c("orange", "orange", "purple", "purple"),   # border color for each outcome key
alpha  = c(0.6, 1, 0.6, 1),                # transparency in legend keys
size   = c(0.6, 0.6, 0.6, 0.6)
),
nrow = 1
),
color = guide_legend(nrow = 1)
) +
labs(
x = "*Predicted* Goodness in €",
y = "Density",
color = "Actual Group",
fill = "Outcome"
) +
theme_minimal(base_family = "Helvetica") +
theme(
legend.title = element_blank(),
legend.text = element_text(size = 20),
axis.title = element_text(size = 20, face = "bold", color = "black"),
axis.text.x = element_text(size = 16, color = "black"),
axis.text.y = element_blank(),
plot.title = element_blank(),
plot.caption = element_blank(),
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm"),
legend.position = "top", legend.box = "vertical"
)
# Compute the line height
y_line <- max(dnorm(x, mu_high, sigma), dnorm(x, mu_low, sigma)) * 1.05
# d' value
dprime <- (mu_high - mu_low) / sigma
# Text position (midpoint between the means)
x_text <- (mu_low + mu_high)/2
sdt_plot <- p +
# d' line
geom_segment(aes(x = mu_low, xend = mu_high, y = y_line, yend = y_line), size = 1.2, color = "black")+
# d' text
geom_text(aes(x = x_text, y = y_line*1.05, label = paste0("d' = ", round(dprime, 2))), inherit.aes = FALSE, size = 5)
###### Actual values by selection status
