library(ggplot2)
library(patchwork)
set.seed(123)
df <- data.frame(
x = rnorm(300, 0, 1.5),
y = rnorm(300)
)
cutoff <- 0
# main scatterplot
p_main <- ggplot(df, aes(x, y)) +
geom_point(alpha = 0.6) +
theme_classic()
# top marginal density, split by cutoff
p_top <- ggplot(df, aes(x)) +
stat_density(geom = "area",
aes(fill = x < cutoff),
position = "identity",
alpha = 0.6,
trim = TRUE) +
scale_fill_manual(values = c("TRUE" = "steelblue", "FALSE" = "tomato")) +
theme_void() +
theme(legend.position = "none")
# assemble: top over main, in ggMarginal style
p_top / p_main + plot_layout(heights = c(1, 4))
library(ggplot2)
library(patchwork)
set.seed(123)
df <- data.frame(
x = rnorm(300, 0, 1.5),
y = rnorm(300)
)
cutoff <- 0
# ---- main scatter ----
p_main <- ggplot(df, aes(x, y)) +
geom_point(alpha = 0.6) +
theme_classic()
# ---- compute density and split at cutoff ----
dens <- density(df$x, n = 512)
dens_df <- data.frame(x = dens$x, y = dens$y)
dens_left  <- subset(dens_df, x <= cutoff)
dens_right <- subset(dens_df, x >= cutoff)
# ---- top marginal with hard cut ----
p_top <- ggplot() +
geom_area(data = dens_left, aes(x, y), fill = "steelblue", alpha = 0.6) +
geom_area(data = dens_right, aes(x, y), fill = "tomato", alpha = 0.6) +
theme_void()
# ---- assemble like ggMarginal ----
p_top / p_main + plot_layout(heights = c(1, 4))
library(patchwork)
dens
