actual_group = rep(c(top_group_label, bottom_group_label), each = length(x))
)
# Add shading info and outcome labels
dens_df <- dens_df %>%
mutate(
fill_side = ifelse(x >= threshold_predicted, "Accept", "Reject"),
outcome = case_when(
actual_group == top_group_label & fill_side == "Accept" ~ "Hit",
actual_group == top_group_label & fill_side == "Reject" ~ "Miss",
actual_group == bottom_group_label  & fill_side == "Accept" ~ "False Alarm",
actual_group == bottom_group_label  & fill_side == "Reject" ~ "Correct Rejection"
),
outcome = factor(outcome, levels = c("Hit", "Miss", "False Alarm", "Correct Rejection"))
)
# --- Plot ---
p <- ggplot() +
# Fill ribbons: draw High group first, Low group second (so Low is on top)
geom_ribbon(
data = filter(dens_df, actual_group == top_group_label),
aes(x = x, ymin = 0, ymax = y, fill = outcome),
color = NA
) +
geom_ribbon(
data = filter(dens_df, actual_group == bottom_group_label),
aes(x = x, ymin = 0, ymax = y, fill = outcome),
color = NA
) +
# Outlines for every region (no legend for this layer)
geom_ribbon(
data = dens_df,
aes(x = x, ymin = 0, ymax = y, group = interaction(outcome, actual_group), color = actual_group),
fill = NA, size = 0.6, show.legend = FALSE
) +
# Density lines (this provides the color legend for groups)
geom_line(data = dens_df, aes(x = x, y = y, color = actual_group), size = 1.1) +
# Threshold
geom_vline(xintercept = threshold_predicted, linetype = "dashed", size = 0.9) +
# Scales: fill = outcomes; color = group
xlim(c(30000, 70000))+
scale_fill_manual(
values = c(
"Hit" = scales::alpha("orange", 0.6),
"Miss" = "white",
"False Alarm" = scales::alpha("purple", 0.6),
"Correct Rejection" = "white"
)
) +
# scale_color_manual(values = c(top_group_label = "purple", bottom_group_label = "orange")) +
scale_color_manual(values = setNames(
c("orange", "purple"),
c(top_group_label, bottom_group_label)
)) +
# Make the fill legend keys show colored outlines for the white entries:
guides(
fill = guide_legend(
override.aes = list(
colour = c("orange", "orange", "purple", "purple"),   # border color for each outcome key
alpha  = c(0.6, 1, 0.6, 1),                # transparency in legend keys
size   = c(0.6, 0.6, 0.6, 0.6)
),
nrow = 1
),
color = guide_legend(nrow = 1)
) +
labs(
x = "*Predicted* Goodness in €",
y = "Density",
color = "Actual Group",
fill = "Outcome"
) +
theme_minimal(base_family = "Helvetica") +
theme(
legend.title = element_blank(),
legend.text = element_text(size = 20),
axis.title = element_text(size = 20, face = "bold", color = "black"),
axis.text.x = element_text(size = 16, color = "black"),
axis.text.y = element_blank(),
plot.title = element_blank(),
plot.caption = element_blank(),
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm"),
legend.position = "bottom", legend.box = "vertical"
)
# Compute the line height
y_line <- max(dnorm(x, mu_high, sigma), dnorm(x, mu_low, sigma)) * 1.05
# d' value
dprime <- (mu_high - mu_low) / sigma
# Text position (midpoint between the means)
x_text <- (mu_low + mu_high)/2
sdt_plot <- p +
# d' line
geom_segment(aes(x = mu_low, xend = mu_high, y = y_line, yend = y_line), size = 1.2, color = "black")+
# d' text
geom_text(aes(x = x_text, y = y_line*1.05, label = paste0("d' = ", round(dprime, 2))), inherit.aes = FALSE, size = 5)
###### Actual values by selection status
# ---- Compute actual distributions given selection ----
# Priors for top/bottom groups (here: 25% top, 75% bottom)
pi_high <- top_x
pi_low  <- 1 - top_x
# Probabilities of being selected given actual group
p_sel_high <- 1 - pnorm(threshold_predicted, mean = mu_high, sd = sigma)
p_sel_low  <- 1 - pnorm(threshold_predicted, mean = mu_low,  sd = sigma)
# Overall probability of selection
p_sel <- pi_high * p_sel_high + pi_low * p_sel_low
# Posterior weights among selected
w_high_sel <- (pi_high * p_sel_high) / p_sel
w_low_sel  <- 1 - w_high_sel
# Posterior weights among not selected
w_high_not <- (pi_high * (1 - p_sel_high)) / (1 - p_sel)
w_low_not  <- 1 - w_high_not
# Build densities of actual values (assume sigma for both groups)
dens_actual <- data.frame(
x = rep(x, 2),
y = c(
# Accepted = mixture of High and Low actuals
w_high_sel * dnorm(x, mu_high, sigma) + w_low_sel * dnorm(x, mu_low, sigma),
# Rejected = mixture of High and Low actuals
w_high_not * dnorm(x, mu_high, sigma) + w_low_not * dnorm(x, mu_low, sigma)
),
group = rep(c("Accepted", "Rejected"), each = length(x))
)
# Add color for alternating stripes / outlines
dens_actual <- dens_actual %>%
mutate(
color_group = rep(c("High Actual", "Low Actual"), length.out = n())
)
dens_actual$group <- factor(dens_actual$group, levels = c("Rejected", "Accepted"))
dens_actual <- dens_actual[order(dens_actual$group), ]
# Plot
actual_value_by_acceptance <- ggplot(dens_actual, aes(x = x, y = y)) +
# Accepted: striped fill
# geom_ribbon_pattern(
#     data = dens_actual %>% filter(group == "Accepted"),
#     aes(ymin = 0, ymax = y),
#     fill = "orange", pattern_fill = "purple",
#     pattern = "stripe",
#     pattern_angle = 90,
#     pattern_density = .3,
#     pattern_spacing = 0.3,
#     pattern_size = .1,
#     color = NA,   # no outline for filled stripes
#     alpha = 0.6
# ) +
geom_ribbon(
data = dens_actual,
aes(ymin = 0, ymax = y, fill = group, group = group),
color = "black",
alpha = 0.3,
size = .2
) +
geom_ribbon(
data = dens_actual,
aes(ymin = 0, ymax = y, fill = group, color = color_group, linetype = color_group),
# fill = NA,
alpha = 0.3,
size = 1.2
) +
# Rejected: white fill, dashed outline
# geom_line(
#     data = dens_actual %>% filter(group == "Rejected"),
#     aes(color = color_group, linetype = color_group),
#     size = 1.2
# ) +
xlim(c(30000, 70000))+
scale_fill_manual(values = c("Accepted" = "#cf6378", "Rejected" = "white")) +
# scale_pattern_fill_manual(values = c("High Actual" = "orange", "Low Actual" = "purple")) +
scale_color_manual(values = c("High Actual" = "orange", "Low Actual" = "purple")) +
scale_linetype_manual(values = c("High Actual" = "solid", "Low Actual" = "dashed")) +
labs(
x = "*Actual* goodness in €",
y = "Density",
fill = "Actual Group",
color = "Actual Group",
linetype = "Actual Group"
) +
guides(
color = "none",
linetype = "none"
) +
theme_minimal(base_family = "Helvetica") +
theme(
legend.title = element_blank(),
legend.text = element_text(size = 20),
axis.title = element_text(size = 20, face = "bold", color = "black"),
axis.text.x = element_text(size = 16, color = "black"),
axis.text.y = element_blank(),
plot.title = element_blank(),
plot.caption = element_blank(),
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm"),
legend.position = "bottom", legend.box = "vertical"
)
